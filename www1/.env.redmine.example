# cp .env.redmine.example .env.redmine
TZ=Asia/Seoul

# 실제 우선순위는 바인드 마운트되는 database.yml 에 있습니다.
REDMINE_DB_MYSQL=172.17.0.1
REDMINE_DB_PORT=23306
REDMINE_DB_USERNAME=redmine
REDMINE_DB_PASSWORD=change-me
REDMINE_DB_DATABASE=redmine

# REDMINE_NO_DB_MIGRATE 는 절대 "0" 으로 설정하지 마세요.
# entrypoint 가 -z(비어 있음) 로 판별하므로 =0 도 "설정됨"으로 간주되어
# db:migrate 가 건너뛰어집니다. 스키마 업그레이드가 필요하면 통째로 비워야 합니다.
#REDMINE_NO_DB_MIGRATE=1
