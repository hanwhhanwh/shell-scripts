# Compose 보간 전용 템플릿. 실제 값은 .env 에 넣고 커밋하지 않습니다.
#   cp .env.example .env
# 이미지 태그 / 공개 포트 / 호스트 경로만 담습니다.
# 컨테이너에 주입되는 환경변수와 비밀값은 .env.<service> 를 참고하세요.

TZ=Asia/Seoul

# --- mariadb ---
MARIADB_TAG=12.3.3-noble
MARIADB_DATA_DIR=/home/mariadb
MARIADB_PORT=23306

# --- redmine ---
REDMINE_TAG=7.0.2-alpine3.24
REDMINE_PORT=3000
REDMINE_FILES=/home/redmine/files
REDMINE_LOGS=/home/redmine/logs
REDMINE_PLUGINS=/home/redmine/plugins
REDMINE_DATA=/home/redmine/data
REDMINE_LOG_CONFIG=/home/redmine/config/additional_environment.rb
REDMINE_DB_CONFIG=/home/redmine/config/database.yml

# --- gitea ---
GITEA_TAG=1.27.3-rootless
GITEA_DATA_DIR=/home/gitea
GITEA_HTTP_PORT=3333
GITEA_SSH_PORT=2222

# --- haproxy ---
HAPROXY_TAG=3.2.26-alpine
HAPROXY_DATA_DIR=/home/haproxy
HAPROXY_PORT=443

# --- wireguard ---
WIREGUARD_TAG=1.0.20260223
WIREGUARD_DATA_DIR=/home/wireguard
WIREGUARD_PORT=51820
