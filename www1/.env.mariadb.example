# cp .env.mariadb.example .env.mariadb
TZ=Asia/Seoul
MYSQL_PORT=23306

# 기동 시 mariadb-upgrade 수행 + 헬스체크 계정 생성. 비워 두면 이미지가
# "upgrade and creating healthcheck users" 단계를 건너뛰어 healthcheck.sh
# --connect 가 인증 실패로 계속 unhealthy 가 됩니다.
MARIADB_AUTO_UPGRADE=true

# MARIADB_ROOT_PASSWORD 는 빈 데이터디렉터리의 최초 초기화에서만 소비됩니다.
# 기존 데이터디렉터리에는 영향을 주지 않습니다.
#MARIADB_ROOT_PASSWORD=
