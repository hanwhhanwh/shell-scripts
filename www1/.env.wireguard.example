# cp .env.wireguard.example .env.wireguard
TZ=Asia/Seoul
SERVERPORT=51820
INTERNAL_SUBNET=10.1.2.0
PEERS=5
PUID=1000
PGID=1000

# PEERDNS / ALLOWEDIPS 는 기본으로 넣지 않습니다.
# ALLOWEDIPS=0.0.0.0/0 는 모든 피어를 풀 터널로 전환합니다.
# 추가하면 기존 피어 conf 재생성 여부(클라이언트 재설정 필요 여부)를
# 반드시 별도로 검증하세요.
#PEERDNS=auto
#ALLOWEDIPS=0.0.0.0/0
